# Set these in Vercel: project web-resume -> Settings -> Environment Variables (Production).
# Never commit real values.

# GitHub OAuth app (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string of at least 32 characters, used to sign the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The only GitHub account allowed to edit.
ALLOWED_GITHUB_USER=redbonzai

# Public address of the site, with no trailing slash. Must match the OAuth app's callback host.
SITE_URL=https://web-resume-beryl.vercel.app

# Repository and branch the editor commits to.
GITHUB_REPO=redbonzai/web-resume
GITHUB_BRANCH=main

# Fine-grained personal access token limited to this one repository with
# "Contents: Read and write". Used only on the server to commit resume.json.
GITHUB_TOKEN=
